{
  "name": "notepick-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "knowledge:build": "python ../scripts/build_hardware_knowledge.py",
    "report:scoring": "node scripts/scoring-report.mjs",
    "knowledge:runtime": "node ../scripts/build_recommendation_knowledge.mjs",
    "predev": "npm run knowledge:runtime",
    "prebuild": "npm run knowledge:runtime",
    "report:recommendations": "node scripts/recommendation-report.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.5.2",
    "tailwindcss": "4.1.12",
    "vite": "6.3.5"
  }
}
